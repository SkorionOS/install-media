#!/bin/bash
# Safe stub for frzr-deploy — never deploys images.
set -euo pipefail

RECORD="${INSTALLER_STUB_RECORD_DEPLOY:-/tmp/installer-stub-deploy.json}"
EXIT_CODE="${INSTALLER_STUB_DEPLOY_EXIT:-${INSTALLER_STUB_EXIT:-0}}"

mkdir -p "$(dirname "$RECORD")"
python3 - <<'PY' "$RECORD" "$EXIT_CODE" "$@"
import json, os, sys, time
record_path, exit_code, argv = sys.argv[1], int(sys.argv[2]), sys.argv[3:]
payload = {"argv": argv, "env": {k: v for k, v in os.environ.items() if k.startswith("FRZR_")}}
with open(record_path, "w", encoding="utf-8") as fh:
    json.dump(payload, fh, indent=2)
    fh.write("\n")
print(f"[stub frzr-deploy] argv={argv!r}", flush=True)
for i in range(1, 5):
    print(f"[stub] deploy progress {i*25}%", flush=True)
    time.sleep(float(os.environ.get("INSTALLER_STUB_SLEEP", "0.05")))
raise SystemExit(exit_code)
PY
