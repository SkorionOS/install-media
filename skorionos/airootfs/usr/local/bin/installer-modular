#!/usr/bin/env bash
# SkorionOS Graphical Installer - Modular Version Launcher
# This script sets up the environment and launches the modular installer

set -e

# Configuration
GAMESCOPE_STARTUP_TIMEOUT=30  # Seconds to wait for gamescope startup

echo "=========================================="
echo "SkorionOS Installer - Modular Version"
echo "=========================================="
echo ""

# Check dependencies
REQUIRED_BINS=("gamescope" "python3")
MISSING_BINS=()

get_gamescope_binary() {
    command -v gamescope
}

gamescope_has_option() {
    if ($(get_gamescope_binary) --help 2>&1 | grep -e "$1" > /dev/null); then
        return 0
    fi

    return 1
}

for bin in "${REQUIRED_BINS[@]}"; do
    if ! command -v "$bin" &> /dev/null; then
        MISSING_BINS+=("$bin")
    fi
done

if [ ${#MISSING_BINS[@]} -gt 0 ]; then
    echo "[ERROR] Missing dependencies: ${MISSING_BINS[*]}"
    echo "   Please install them first."
    exit 1
fi

# Check Python modules
echo "Checking Python dependencies..."
if ! python3 -c "import gi; gi.require_version('Gtk', '4.0')" 2>/dev/null; then
    echo "[ERROR] GTK4 Python bindings not found"
    echo "   Install python-gobject package"
    exit 1
fi

if ! python3 -c "import gi; gi.require_version('NM', '1.0')" 2>/dev/null; then
    echo "[WARNING] NetworkManager Python bindings not found"
    echo "   Network features may not work"
fi

echo "[OK] All dependencies found"
echo ""

# Setup XDG_RUNTIME_DIR
if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/tmp/runtime-${USER}"
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 700 "$XDG_RUNTIME_DIR"
    echo "  Created XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"
fi

# Detect screen resolution
SCREEN_WIDTH=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null | cut -d ',' -f 1 || echo "1280")
SCREEN_HEIGHT=$(cat /sys/class/graphics/fb0/virtual_size 2>/dev/null | cut -d ',' -f 2 || echo "800")

# Fallback to xrandr if fb0 doesn't exist
if [ "$SCREEN_WIDTH" == "1280" ] && command -v xrandr &> /dev/null; then
    RESOLUTION=$(xrandr 2>/dev/null | grep '*' | awk '{print $1}' | head -n1)
    if [ -n "$RESOLUTION" ]; then
        SCREEN_WIDTH=$(echo "$RESOLUTION" | cut -d 'x' -f 1)
        SCREEN_HEIGHT=$(echo "$RESOLUTION" | cut -d 'x' -f 2)
    fi
fi

echo " resolution: ${SCREEN_WIDTH}x${SCREEN_HEIGHT}"


# Source device quirks for screen orientation and output
QUIRKS_FILE="/usr/share/installer/device-quirks"
if [ -f "$QUIRKS_FILE" ]; then
    echo ""
    echo "  Loading device quirks..."
    source "$QUIRKS_FILE"
    echo "   Device: $(cat /sys/class/dmi/id/product_name 2>/dev/null || echo 'Unknown')"
    [ -n "$ORIENTATION" ] && echo "   Orientation: $ORIENTATION"
    [ -n "$OUTPUT_CONNECTOR" ] && echo "   Output: $OUTPUT_CONNECTOR"
    [ -n "$USE_ROTATION_SHADER" ] && echo "   Rotation Shader: enabled"
    [ -n "$GAMESCOPE_TAP_TO_CLICK" ] && echo "   Tap to Click: enabled"
    [ -n "$GAMESCOPE_TAP_DRAG_LOCK" ] && echo "   Tap Drag Lock: enabled"
    [ -n "$GAMESCOPE_NATURAL_SCROLL" ] && echo "   Natural Scroll: $GAMESCOPE_NATURAL_SCROLL"
fi

# Swap width and height for 90/270 degree rotations
if [[ "$ORIENTATION" == "left" || "$ORIENTATION" == "right" || "$SCREEN_HEIGHT" -gt "$SCREEN_WIDTH" ]]; then
    echo ""
    echo "Swapping width/height for ${ORIENTATION} rotation"
    echo "   Original: ${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
    TEMP=$SCREEN_WIDTH
    SCREEN_WIDTH=$SCREEN_HEIGHT
    SCREEN_HEIGHT=$TEMP
    echo "   Adjusted screen size: ${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
fi

export SCREEN_WIDTH
export SCREEN_HEIGHT
echo "Screen size: ${SCREEN_WIDTH}x${SCREEN_HEIGHT}"

# INNER_WIDTH=1280
# INNER_HEIGHT=$(awk "BEGIN {printf \"%.0f\", $INSTALLER_HEIGHT * 1280 / $INSTALLER_WIDTH}")

# INNER_WIDTH=""
# INNER_HEIGHT=""

# export INNER_WIDTH
# export INNER_HEIGHT
# echo "   Inner size: ${INNER_WIDTH}x${INNER_HEIGHT}"

# UI_SCALE can be set manually (default: 1.0)
GDK_SCALE=1
UI_SCALE=1
if [ "$SCREEN_HEIGHT" -ge 1440 ]; then
    GDK_SCALE=$((SCREEN_HEIGHT / 720))
elif [ "$SCREEN_HEIGHT" -ge 720 ]; then
    UI_SCALE=$(awk "BEGIN {printf \"%.2f\", $SCREEN_HEIGHT / 720}")
fi

export UI_SCALE
export GDK_SCALE
echo "   UI scale: ${UI_SCALE}, GDK scale: ${GDK_SCALE}"


if [ "$GDK_SCALE" -gt 1 ]; then
    INSTALLER_WIDTH=$((SCREEN_WIDTH / GDK_SCALE))
    INSTALLER_HEIGHT=$((SCREEN_HEIGHT / GDK_SCALE))
else
    INSTALLER_WIDTH=$SCREEN_WIDTH
    INSTALLER_HEIGHT=$SCREEN_HEIGHT
fi

# Pass actual resolution to Python app (UI will auto-scale via CSS)
export INSTALLER_WIDTH
export INSTALLER_HEIGHT
echo "Window size: ${INSTALLER_WIDTH}x${INSTALLER_HEIGHT}"

echo ""
echo "Starting gamescope with socket detection..."
echo ""

# Log file for debugging
LOGFILE="/tmp/installer-modular.log"
UNIFIED_LOG="/tmp/frzr.log"  # 统一日志文件
echo "Logging to: $LOGFILE (and $UNIFIED_LOG)"
echo ""

########################################################
# envs
########################################################
export INTEL_DEBUG=norbc
export mesa_glthread=true

if /usr/local/bin/gamescope-sdl-workaround; then
	# Skip on legacy hardware
	export ENABLE_GAMESCOPE_WSI=0
else
	export ENABLE_GAMESCOPE_WSI=1
fi

# Force Qt applications to run under xwayland
export QT_QPA_PLATFORM=xcb

# Some environment variables by default (taken from Deck session)
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0

# Don't wait for buffers to idle on the client side before sending them to gamescope
export vk_xwayland_wait_ready=false

# Handle Nvidia GPUs
if lsmod | grep -q '^nvidia'; then
    # https://github.com/ValveSoftware/gamescope/pull/1671
    export GAMESCOPE_WSI_HIDE_PRESENT_WAIT_EXT=1
    export ENABLE_GAMESCOPE_HDR=1
fi


########################################################
# gamescope command
########################################################

# Build gamescope command with device-specific options
GAMESCOPE_CMD="gamescope \
  -f \
  -F fsr \
  --xwayland-count 2 \
  --default-touch-mode 4 \
  --force-grab-cursor \
  --expose-wayland \
  "

# Add device-specific options
[ -n "$ORIENTATION" ] && GAMESCOPE_CMD+=" --force-orientation $ORIENTATION"
[ -n "$OUTPUT_CONNECTOR" ] && GAMESCOPE_CMD+=" --prefer-output $OUTPUT_CONNECTOR"
[ -n "$USE_ROTATION_SHADER" ] && GAMESCOPE_CMD+=" --use-rotation-shader $USE_ROTATION_SHADER"

[ -n "$INNER_WIDTH" ] && GAMESCOPE_CMD+=" -w $INNER_WIDTH"
[ -n "$INNER_HEIGHT" ] && GAMESCOPE_CMD+=" -h $INNER_HEIGHT"

[ -n "$GAMESCOPE_TAP_TO_CLICK" ] && gamescope_has_option "--tap-to-click" && GAMESCOPE_CMD+=" --tap-to-click"
[ -n "$GAMESCOPE_TAP_DRAG_LOCK" ] && gamescope_has_option "--drag-lock" && GAMESCOPE_CMD+=" --drag-lock"
[ -n "$GAMESCOPE_NATURAL_SCROLL" ] && gamescope_has_option "--natural-scrolling" && GAMESCOPE_CMD+=" --natural-scrolling $GAMESCOPE_NATURAL_SCROLL"

# Setup socket for gamescope startup detection
tmpdir="$([[ -n ${XDG_RUNTIME_DIR+x} ]] && mktemp -p "$XDG_RUNTIME_DIR" -d -t installer-gamescope.XXXXXXX)"
socket="${tmpdir:+$tmpdir/startup.socket}"

if [[ -z $tmpdir || -z ${XDG_RUNTIME_DIR+x} ]]; then
    echo "ERROR: Failed to create runtime directory for socket" >&2
    exit 1
fi

mkfifo -- "$socket"
GAMESCOPE_CMD+=" -R $socket"

echo "Socket created at: $socket"

# Launch with logging and socket detection
{
    echo "=========================================="
    echo "Installer Modular Log - $(date)"
    echo "=========================================="
    echo "Resolution: ${SCREEN_WIDTH}x${SCREEN_HEIGHT}"
    echo "Window size: ${INSTALLER_WIDTH}x${INSTALLER_HEIGHT}"
    echo "UI_SCALE: ${UI_SCALE:-1.0}"
    echo "GDK_SCALE: ${GDK_SCALE:-1}"
    echo "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"
    echo "TTY: $(tty)"
    echo "Device: $(cat /sys/class/dmi/id/product_name 2>/dev/null || echo 'Unknown')"
    [ -n "$ORIENTATION" ] && echo "Orientation: $ORIENTATION"
    [ -n "$OUTPUT_CONNECTOR" ] && echo "Output: $OUTPUT_CONNECTOR"
    [ -n "$USE_ROTATION_SHADER" ] && echo "Rotation Shader: $USE_ROTATION_SHADER"
    [ -n "$GAMESCOPE_TAP_TO_CLICK" ] && echo "Tap to Click: $GAMESCOPE_TAP_TO_CLICK"
    [ -n "$GAMESCOPE_TAP_DRAG_LOCK" ] && echo "Tap Drag Lock: $GAMESCOPE_TAP_DRAG_LOCK"
    [ -n "$GAMESCOPE_NATURAL_SCROLL" ] && echo "Natural Scroll: $GAMESCOPE_NATURAL_SCROLL"
    echo "Socket: $socket"
    echo ""
    echo "Gamescope command:"
    echo "$GAMESCOPE_CMD"
    echo ""
    
    # Clean up XKB cache and stale sockets to prevent startup failures
    echo "Cleaning up XKB cache and stale sockets..."
    rm -rf /var/lib/xkb/* 2>/dev/null || true
    mkdir -p /var/lib/xkb 2>/dev/null || true
    chmod 755 /var/lib/xkb 2>/dev/null || true
    rm -f /tmp/.X11-unix/X* 2>/dev/null || true
    rm -f "${XDG_RUNTIME_DIR}/wayland-"* 2>/dev/null || true
    rm -f "${XDG_RUNTIME_DIR}/.X11-unix/"* 2>/dev/null || true
    echo "Cleanup complete"
    echo ""
    
    # Note: Not setting GDK_BACKEND=wayland to allow GTK auto-detection
    # GTK will try Wayland first, then fallback if needed
    # The "Wayland compositor does not provide..." warning is harmless
    
    # Start gamescope in background
    $GAMESCOPE_CMD -- python3 /usr/local/bin/installer "$@" 2>&1 &
    gamescope_pid=$!
    
    echo "Gamescope started with PID: $gamescope_pid"
    echo "Waiting for socket response (timeout: ${GAMESCOPE_STARTUP_TIMEOUT}s)..."
    
    # Check socket with timeout
    if read -r -t $GAMESCOPE_STARTUP_TIMEOUT response_x_display response_wl_display <> "$socket"; then
        export DISPLAY="$response_x_display"
        export GAMESCOPE_WAYLAND_DISPLAY="$response_wl_display"
        echo "✅ Gamescope started successfully"
        echo "   DISPLAY=$DISPLAY"
        echo "   GAMESCOPE_WAYLAND_DISPLAY=$GAMESCOPE_WAYLAND_DISPLAY"
        echo ""
        
        # Wait for gamescope to finish
        wait $gamescope_pid
        EXIT_CODE=$?
    else
        echo "❌ Gamescope failed to start within ${GAMESCOPE_STARTUP_TIMEOUT} seconds"
        echo ""
        echo "Possible solutions:"
        echo "  1. Check if your GPU supports Vulkan: vulkaninfo"
        echo "  2. Check DRM devices: ls -la /dev/dri/"
        echo "  3. Review the log file: $LOGFILE"
        echo "  4. Try running 'gamescope --help' to verify installation"
        echo ""
        echo "   Killing gamescope process..."
        kill -9 $gamescope_pid 2>/dev/null
        wait $gamescope_pid 2>/dev/null
        EXIT_CODE=1
    fi
    
    echo ""
    echo "=========================================="
    echo "Exit code: $EXIT_CODE"
    echo "=========================================="
    
    # Cleanup socket
    rm -rf "$tmpdir" 2>/dev/null
    
    exit $EXIT_CODE
} 2>&1 | tee "$LOGFILE" | tee -a "$UNIFIED_LOG"

# Preserve exit code from the command block (not from tee)
exit ${PIPESTATUS[0]}

