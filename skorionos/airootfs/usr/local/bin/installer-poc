#!/bin/bash
# PoC Launcher for Graphical Installer

echo "=========================================="
echo "SkorionOS Graphical Installer PoC"
echo "=========================================="

# Check dependencies
check_dependencies() {
    local missing=()
    
    command -v gamescope >/dev/null 2>&1 || missing+=("gamescope")
    command -v python3 >/dev/null 2>&1 || missing+=("python3")
    python3 -c "import gi; gi.require_version('Gtk', '4.0')" 2>/dev/null || missing+=("python-gobject + GTK4")
    
    if [ ${#missing[@]} -gt 0 ]; then
        echo "❌ Missing dependencies: ${missing[*]}"
        echo ""
        echo "Please install:"
        echo "  pacman -S gamescope gtk4 python-gobject"
        echo ""
        read -p "Press any key to return..." -n1
        exit 1
    fi
    
    echo "✅ All dependencies installed"
}

check_dependencies

# Setup environment
export XDG_RUNTIME_DIR=/tmp/runtime-root
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# Setup SDL for controller support
export SDL_JOYSTICK_DEVICE=/dev/input/event*
export SDL_GAMECONTROLLERCONFIG_FILE=/etc/SDL_GameControllerDB.txt

# Detect resolution
RESOLUTION=$(cat /sys/class/drm/card*/modes 2>/dev/null | head -1)
WIDTH=${RESOLUTION%x*}
HEIGHT=${RESOLUTION#*x}

# Default resolution if detection fails
WIDTH=${WIDTH:-1280}
HEIGHT=${HEIGHT:-800}

echo "✅ Detected resolution: ${WIDTH}x${HEIGHT}"

# Set GTK DPI scaling based on resolution
# Use GDK_DPI_SCALE instead of GDK_SCALE to avoid window size issues
if [ "$HEIGHT" -ge 1440 ]; then
    export GDK_SCALE=2
    export UI_SCALE=1
elif [ "$HEIGHT" -ge 1080 ]; then
    export GDK_SCALE=1
    # export UI_SCALE=1.5
else
    export GDK_SCALE=1
    export UI_SCALE=1
fi

# GDK_SCALE is optional, set it manually for testing combined with CSS scaling
# export GDK_SCALE=2

# Pass actual resolution to Python app (UI will auto-scale via CSS)
export INSTALLER_WIDTH="$WIDTH"
export INSTALLER_HEIGHT="$HEIGHT"
echo "📐 Window size: ${INSTALLER_WIDTH}x${INSTALLER_HEIGHT}"

echo "🚀 Starting gamescope..."
echo ""

# Log file for debugging
LOGFILE="/tmp/installer-poc.log"
echo "📝 Logging to: $LOGFILE"
echo ""

# Launch gamescope + installer (with logging)
{
    echo "=========================================="
    echo "Installer PoC Log - $(date)"
    echo "=========================================="
    echo "Resolution: ${WIDTH}x${HEIGHT}"
    echo "GDK_SCALE: $GDK_SCALE"
    echo "GDK_DPI_SCALE: $GDK_DPI_SCALE"
    echo "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR"
    echo "TTY: $(tty)"
    echo ""
    
    gamescope \
      -W "$WIDTH" \
      -H "$HEIGHT" \
      -w "$WIDTH" \
      -h "$HEIGHT" \
      -f \
      -F fsr \
      --force-grab-cursor \
      --expose-wayland \
      -- python3 /usr/local/bin/installer-poc.py "$@" 2>&1
    
    EXIT_CODE=$?
    echo ""
    echo "=========================================="
    echo "Exit code: $EXIT_CODE"
    echo "=========================================="
    exit $EXIT_CODE
} | tee "$LOGFILE"

