#!/bin/bash
# shellcheck disable=SC2034,SC2086,SC2155,SC1091

function check_internet_connection() {
  while ! (curl -Ls --http1.1 https://www.baidu.com | grep '<html' >/dev/null); do
    dialog --colors --title "${TITLE_COLOR}$OS_NAME 安装\Zn" \
      --yes-button "网络配置" \
      --no-button "退出安装" \
      --yesno "未检测到互联网连接。请使用网络配置工具激活网络，然后选择 <退出> 以退出工具并继续。" \
      $MSGBOX_HEIGHT $MSGBOX_WIDTH

    if [ $? -ne 0 ]; then
      exit 1
    fi

    nmtui-connect
  done
}

function is_ssh_session() {
  # 检查SSH相关环境变量
  if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_CONNECTION" ] || [ -n "$SSH_TTY" ]; then
    return 0  # 是SSH会话
  fi
  
  # 检查当前TTY是否是SSH
  if [[ "$(tty)" =~ ^/dev/pts/ ]] && pstree -p $$ 2>/dev/null | grep -q sshd; then
    return 0  # 是SSH会话
  fi
  
  return 1  # 不是SSH会话
}

function reload_network_connections() {
  echo "正在应用新的网络配置..."
  
  if ! command -v nmcli &> /dev/null; then
    echo "nmcli不可用，使用服务重启方式"
    systemctl restart NetworkManager 2>/dev/null
    sleep 3
    return 0
  fi
  
  # 1. 重新加载配置
  nmcli connection reload 2>/dev/null
  
  # 2. 获取可用的连接
  local available_connections=$(nmcli -t -f NAME,TYPE connection show 2>/dev/null | grep -v loopback)
  
  if [ -n "$available_connections" ]; then
    echo "找到可用连接，尝试激活..."
    
    # 3. 按优先级尝试连接 (wifi > ethernet > 其他)
    echo "$available_connections" | grep wifi | head -1 | cut -d: -f1 | while read conn; do
      if [ -n "$conn" ]; then
        echo "激活WiFi连接: $conn"
        nmcli connection up "$conn" 2>/dev/null && return 0
      fi
    done
    
    echo "$available_connections" | grep ethernet | head -1 | cut -d: -f1 | while read conn; do
      if [ -n "$conn" ]; then
        echo "激活以太网连接: $conn"
        nmcli connection up "$conn" 2>/dev/null && return 0
      fi
    done
    
    # 4. 如果以上都失败，尝试第一个可用连接
    echo "$available_connections" | head -1 | cut -d: -f1 | while read conn; do
      if [ -n "$conn" ]; then
        echo "激活连接: $conn"
        nmcli connection up "$conn" 2>/dev/null
      fi
    done
  else
    echo "未找到可用连接配置"
  fi
  
  sleep 2
  echo "网络配置应用完成"
}

function copy_system_configs() {
  # 如果是SSH会话，跳过配置复制
  if is_ssh_session; then
    echo "检测到SSH会话，跳过系统配置复制"
    return 0
  fi
  
  local frzr_partition=""
  local mount_point="/tmp/frzr_old_root"
  local network_copied=false
  local ssh_copied=false
  
  echo "正在查找现有系统配置..."
  
  # 查找frzr-root分区
  frzr_partition=$(blkid -l -t LABEL=frzr_root -o device 2>/dev/null)
  
  if [ -z "$frzr_partition" ]; then
    echo "未找到现有系统分区 (frzr_root)，跳过配置复制"
    return 0
  fi
  
  echo "找到现有系统分区: $frzr_partition"
  
  # 检查是否已挂载
  local existing_mount=$(findmnt -n -o TARGET "$frzr_partition" 2>/dev/null)
  
  if [ -n "$existing_mount" ]; then
    mount_point="$existing_mount"
    echo "使用已存在的挂载点: $mount_point"
  else
    # 创建临时挂载点
    mkdir -p "$mount_point"
    if ! mount -o ro "$frzr_partition" "$mount_point" 2>/dev/null; then
      echo "无法挂载现有系统分区"
      rmdir "$mount_point" 2>/dev/null
      return 1
    fi
    echo "已挂载现有系统分区到: $mount_point"
  fi
  
  # 复制网络配置
  local net_src_dir="$mount_point/etc/NetworkManager/system-connections"
  local net_dst_dir="/etc/NetworkManager/system-connections"
  
  if [ -d "$net_src_dir" ]; then
    local config_count=$(ls -1 "$net_src_dir" 2>/dev/null | wc -l)
    if [ "$config_count" -gt 0 ]; then
      echo "找到 $config_count 个网络配置文件，正在复制..."
      
      # 备份现有配置（如果有）
      if [ -d "$net_dst_dir" ] && [ -n "$(ls -A "$net_dst_dir" 2>/dev/null)" ]; then
        mv "$net_dst_dir" "${net_dst_dir}.backup.$(date +%s)" 2>/dev/null
      fi
      
      mkdir -p "$net_dst_dir"
      chmod 700 "$net_dst_dir"
      
      if cp "$net_src_dir"/* "$net_dst_dir"/ 2>/dev/null; then
        chmod 600 "$net_dst_dir"/*
        echo "成功复制 $config_count 个网络配置文件"
        network_copied=true
      else
        echo "复制网络配置时出错"
      fi
    else
      echo "现有系统中无网络配置文件"
    fi
  else
    echo "现有系统中未找到网络配置目录"
  fi
  
  # 复制SSH主机密钥
  local ssh_src_dir="$mount_point/etc/ssh"
  local ssh_dst_dir="/etc/ssh"
  
  if [ -d "$ssh_src_dir" ]; then
    local key_count=0
    
    # 计算主机密钥文件数量
    key_count=$(ls -1 "$ssh_src_dir"/ssh_host_*_key 2>/dev/null | wc -l)
    
    if [ "$key_count" -gt 0 ]; then
      echo "找到 $key_count 个SSH主机密钥，正在复制..."
      
      # 复制所有主机密钥文件（私钥和公钥）
      for key_file in "$ssh_src_dir"/ssh_host_*_key*; do
        if [ -f "$key_file" ]; then
          local key_name=$(basename "$key_file")
          if cp "$key_file" "$ssh_dst_dir/$key_name" 2>/dev/null; then
            # 设置正确权限
            if [[ "$key_name" == *".pub" ]]; then
              chmod 644 "$ssh_dst_dir/$key_name"  # 公钥
            else
              chmod 600 "$ssh_dst_dir/$key_name"  # 私钥
            fi
            echo "已复制SSH密钥: $key_name"
          fi
        fi
      done
      
      ssh_copied=true
    else
      echo "现有系统中无SSH主机密钥文件"
    fi
  else
    echo "现有系统中未找到SSH配置目录"
  fi
  
  # 清理：只卸载我们自己挂载的分区
  if [ -z "$existing_mount" ]; then
    umount "$mount_point" 2>/dev/null
    rmdir "$mount_point" 2>/dev/null
  fi
  
  # 重新加载服务（如果有配置被复制）
  if [ "$network_copied" = true ]; then
    echo "正在重新加载网络配置..."
    reload_network_connections
  fi
  
  if [ "$ssh_copied" = true ]; then
    echo "正在重启SSH服务..."
    if systemctl restart sshd 2>/dev/null; then
      echo "SSH服务重启成功"
    else
      echo "SSH服务重启失败，但密钥已复制"
    fi
  fi
  
  return 0
}

enable_all_gamepads() {
        # by default, only handheld gamepads are enabled, this enables all other supported gamepads
        busctl set-property org.shadowblip.InputPlumber /org/shadowblip/InputPlumber/Manager \
            org.shadowblip.InputManager \
            ManageAllDevices b 1 &> /dev/null
}

load_gamepad_profile() {
        # load a gamepad profile that emulates a keyboard for interaction with the keyboard based UI
        busctl call org.shadowblip.InputPlumber \
                /org/shadowblip/InputPlumber/CompositeDevice0 \
                org.shadowblip.Input.CompositeDevice \
                LoadProfilePath "s" /root/gamepad_profile.yaml &> /dev/null
}

poll_gamepad() {
        modprobe xpad > /dev/null
        systemctl start inputplumber > /dev/null

        while true; do
                sleep 1
                enable_all_gamepads
                load_gamepad_profile
                if [ $? == 0 ]; then
                        break
                fi
        done
}